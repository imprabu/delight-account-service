<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_DIR">${env:LOG_DIR:-logs}</Property>
        <Property name="APP_NAME">${env:APP_NAME:-delight-account-service}</Property>
        <Property name="DELIGHT_LOG_LEVEL">${env:DELIGHT_LOG_LEVEL:-INFO}</Property>
        <Property name="HIBERNATE_LOG_LEVEL">${env:HIBERNATE_LOG_LEVEL:-INFO}</Property>
    </Properties>
    <Appenders>
        <!-- Console appender with JSON format for structured logging -->
        <Console name="Console" target="SYSTEM_OUT">
            <JsonTemplateLayout eventTemplateUri="classpath:JsonLayout.json"/>
        </Console>
        
        <!-- Rolling file appender with JSON format -->
        <RollingFile name="RollingFile"
                     fileName="${LOG_DIR}/application.log"
                     filePattern="${LOG_DIR}/application-%d{yyyy-MM-dd}.log.gz">
            <JsonTemplateLayout eventTemplateUri="classpath:JsonLayout.json"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>
        
        <!-- Fallback console appender with pattern layout for development -->
        <Console name="ConsolePattern" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %X{domain:Unknown} - %X{requestId:Unknown} - %X{accountId:Unknown} - %logger{0} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Hibernate SQL logger - controls SQL statement logging -->
        <Logger name="org.hibernate.SQL" level="${HIBERNATE_LOG_LEVEL}" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>
        <Logger name="com.delight" level="${DELIGHT_LOG_LEVEL}" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>
        <!-- Enhanced error logging for exception handlers -->
        <Logger name="com.delight.account.exception.handler" level="ERROR" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>
        <!-- Request logging -->
        <Logger name="com.delight.account.filter" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>
        <Logger name="org.hibernate.orm.query.hql" level="${HIBERNATE_LOG_LEVEL}" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>
        <Root level="ERROR">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Root>
    </Loggers>
</Configuration>
