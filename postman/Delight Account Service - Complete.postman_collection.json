							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{channel_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/channel/allAccounts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"channel",
								"allAccounts"
							]
						},
						"description": "Returns a list of all accounts with their organization and product details. **Channel authentication required** - this endpoint only works with Channel JWT tokens, not regular user JWT tokens.\n\n**Authentication:**\n- Requires Channel JWT token (Bearer token) in Authorization header\n- Channel tokens are different from user JWT tokens\n- Generate channel tokens using: `python3 create_channel_jwt.py [account_id] [user_id] [key_version]`\n\n**Account Context Resolution:**\n- If `account_id` is in channel JWT → uses it directly\n- If `account_id` is NOT in channel JWT → extracts domain from Host header and looks up account\n- For domain lookup, include Host header: `Host: <domain>` (e.g., `Host: testcompany`)\n\n**Note:** This endpoint does not include user-specific information. The `/accounts/allAccounts` endpoint has been removed - use this channel endpoint instead."
					},
					"response": []
				},
				{
					"name": "Validate Channel Session",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Channel session validated', function () {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('accountId');",
									"    pm.expect(jsonData).to.have.property('isActive');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{channel_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/channel/validateSession",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"channel",
								"validateSession"
							]
						},
						"description": "Validates the current channel session using Channel JWT token. Supports both GET and POST methods.\n\n**Authentication:**\n- Requires Channel JWT token (Bearer token) in Authorization header\n\n**Account Context Resolution:**\n- If `account_id` is in channel JWT → uses it directly\n- If `account_id` is NOT in channel JWT → extracts domain from Host header and looks up account\n\n**User Context Resolution:**\n- If `user_id` is in channel JWT → uses it directly\n- If `user_id` is NOT in channel JWT → extracts from request body JWT token (for POST requests)"
					},
					"response": []
				},
